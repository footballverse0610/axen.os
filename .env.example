# 起業しよ。 環境変数（サンプル）
# 実際の値は .env.local に記入すること。.env.local はコミットしないこと
# （.gitignoreの `.env*` パターンで除外済み。この .env.example のみ例外的に追跡対象）

# --- Supabase ---
# Supabase Dashboard > Project Settings > API から取得する。
# 以下2つは "anon" / "public" キー（ブラウザに公開して問題ない値）。
# NEXT_PUBLIC_ プレフィックスがついた変数はビルド時にブラウザへ埋め込まれる。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 【重要・サーバー専用】Service Role Key。RLSを全てバイパスする強い権限を持つ。
# NEXT_PUBLIC_ を絶対に付けないこと。ブラウザ向けコード(Client Component等)や
# クライアントに送るレスポンスへ絶対に含めないこと。
# 現時点(Phase: 認証基盤準備)ではまだ使用しない。将来サーバー専用の管理処理
# (例: Route HandlerやServer Actionでの管理者操作)が必要になった場合のみ使う。
SUPABASE_SERVICE_ROLE_KEY=

# --- AI機能 (AI Business Coach) ---
# 【重要・サーバー専用】絶対にNEXT_PUBLIC_を付けないこと。
# src/app/api/coach/route.ts (サーバー側のRoute Handler)からのみ参照し、
# クライアントへは絶対に渡さない。
ANTHROPIC_API_KEY=
